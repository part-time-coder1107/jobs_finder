# ============================================================================
# Direct ATS Job Finder & Daily Alert Configuration (.env)
# Note: You can also configure these directly in the web dashboard UI!
# ============================================================================

# 1. LLM API Key (optional, not used by the daily job scan)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# 2. Gmail SMTP Configuration for sending email job alerts
SMTP_EMAIL=
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
